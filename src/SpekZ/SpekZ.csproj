<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <TargetPlatformMinVersion Condition="'$(PackageChannel)' == 'Sideload'">10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>SpekZ</RootNamespace>
    <AssemblyName>Spek-Z</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WindowIcon.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'arm64' Or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- MSIX is the default. Explicit WindowsPackageType=None still supports the existing unpackaged build. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsPackageType)' != 'None'">false</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(PackageChannel)' == 'Sideload'">true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <IsPackable>false</IsPackable>
    <Product>Spek-Z</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- Windows App SDK 2 copies its AI, Windows ML and search runtimes into self-contained builds, about 50 MB that
         Spek-Z doesn't use. Update these versions with Microsoft.WindowsAppSDK, or restore fails with NU1605. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spek.Net.WinUI\Spek.Net.WinUI.csproj" />
  </ItemGroup>
  <!-- artwork\export.py generates Assets from artwork\spek-z.svg. -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'None'">
    <Content Include="Assets\WindowIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-unplated.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest" Condition="'$(PackageChannel)' != 'Sideload'" />
    <AppxManifest Include="Package.Sideload.appxmanifest" Condition="'$(PackageChannel)' == 'Sideload'" />
    <Content Include="Assets\*.png;Assets\WindowIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\artwork\spek-z.svg" Link="Assets\spek-z.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- scripts\Get-Ffmpeg.ps1 downloads ffmpeg for each architecture. Builds without it look for ffmpeg on PATH. -->
  <PropertyGroup>
    <FfmpegFolder>$(MSBuildThisFileDirectory)..\..\ffmpeg\$(RuntimeIdentifier)\</FfmpegFolder>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(FfmpegFolder)ffmpeg.exe')">
    <None Include="$(FfmpegFolder)ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FfmpegFolder)BUILD.txt" Link="ffmpeg\BUILD.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FfmpegFolder)licenses\*.txt" Link="ffmpeg\licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePackagedFfmpeg" BeforeTargets="PrepareForBuild" Condition="'$(WindowsPackageType)' != 'None'">
    <Error Condition="!Exists('$(FfmpegFolder)ffmpeg.exe') Or !Exists('$(FfmpegFolder)BUILD.txt') Or !Exists('$(FfmpegFolder)licenses\FFmpeg-LGPL-2.1.txt')"
           Text="Packaged builds need FFmpeg and its license files. Run scripts\Get-Ffmpeg.ps1 for the target architecture first." />
  </Target>
</Project>
