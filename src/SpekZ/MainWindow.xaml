<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpekZ.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:spek="using:Spek.Net.WinUI"
    Title="Spek-Z">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Spek-Z" />

        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            OverflowButtonVisibility="Auto">
            <AppBarButton
                AutomationProperties.AutomationId="OpenFile"
                Click="Open_Click"
                Icon="OpenFile"
                Label="Open"
                ToolTipService.ToolTip="Open an audio file (Ctrl+O)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Name="SaveButton"
                Click="Save_Click"
                Icon="Save"
                IsEnabled="False"
                Label="Save image"
                ToolTipService.ToolTip="Save the spectrogram as a PNG (Ctrl+S)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="PaletteButton" ToolTipService.ToolTip="Palette (P, Shift+P)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="PaletteMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="WindowButton" ToolTipService.ToolTip="Window function (F, Shift+F)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="WindowMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="FftButton" ToolTipService.ToolTip="FFT window size. Fewer samples: finer timing. More samples: finer frequency detail. W or Shift+W.">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B9;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="FftMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="ChannelButton" ToolTipService.ToolTip="Channel (C, Shift+C)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8D6;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="ChannelMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                x:Name="StreamButton"
                ToolTipService.ToolTip="Audio stream (S, Shift+S)"
                Visibility="Collapsed">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="StreamMenu" Opening="Menu_Opening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                AutomationProperties.AutomationId="Settings"
                Click="Settings_Click"
                Icon="Setting"
                Label="Settings"
                ToolTipService.ToolTip="Settings (Ctrl+E)">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="E" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="2" Margin="16,4,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="NavigationContent" Spacing="8">
                <Grid x:Name="InspectionControls" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            AutomationProperties.AutomationId="ReferenceLinesLabel"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Reference lines" />
                        <ComboBox
                            x:Name="ReferenceLinesBox"
                            Width="184"
                            AutomationProperties.AutomationId="ReferenceLines"
                            AutomationProperties.Name="Reference lines"
                            SelectionChanged="ReferenceLines_Changed"
                            ToolTipService.ToolTip="Approximate LAME stereo CBR low-pass targets. Not bitrate detection.">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="MP3 - LAME defaults" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox
                        x:Name="SpectrumToggle"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="ShowSpectrum"
                        Checked="InspectionOption_Changed"
                        Content="Spectrum profile"
                        Unchecked="InspectionOption_Changed" />
                    <CheckBox
                        x:Name="CutoffToggle"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="ShowCutoff"
                        Checked="InspectionOption_Changed"
                        Content="Cutoff marker"
                        ToolTipService.ToolTip="Measure a sustained spectral drop in the selected passage. This does not prove a lossy source."
                        Unchecked="InspectionOption_Changed" />
                    <Button
                        x:Name="ResetZoomButton"
                        Grid.Column="3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="ResetZoom"
                        Click="ResetZoom_Click"
                        Content="Reset zoom"
                        ToolTipService.ToolTip="Reset time and frequency zoom (R or double-click the plot)" />
                </Grid>
                <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ZoomReadout"
                        MaxWidth="128"
                        AutomationProperties.AutomationId="ZoomReadout"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Zoom: 100%"
                        TextWrapping="Wrap" />
                    <UserControl
                        x:Name="HoverReadout"
                        Grid.Column="1"
                        Width="208"
                        DataContext="{x:Bind Spek, Mode=OneTime}"
                        AutomationProperties.AutomationId="HoverReadout"
                        AutomationProperties.Name="{Binding ReadoutText}"
                        MinHeight="16"
                        IsTabStop="False">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                AutomationProperties.AutomationId="TimeReadout"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding ReadoutTimeText}"
                                TextAlignment="Right" />
                            <TextBlock
                                Grid.Column="1"
                                AutomationProperties.AutomationId="FrequencyReadout"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding ReadoutFrequencyText}"
                                TextAlignment="Right" />
                            <TextBlock
                                Grid.Column="2"
                                AutomationProperties.AutomationId="LevelReadout"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding ReadoutLevelText}"
                                TextAlignment="Right"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding ReadoutLevelText}" />
                        </Grid>
                    </UserControl>
                </Grid>
            </StackPanel>
            <spek:SpectrogramOverview
                x:Name="Overview"
                Grid.Column="1"
                Height="Auto"
                VerticalAlignment="Top"
                Source="{x:Bind Spek, Mode=OneTime}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <spek:SpekView x:Name="Spek" AllowDrop="True" />
            <spek:SpectrumProfileView
                x:Name="Profile"
                Grid.Row="1"
                Height="180"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel Grid.Row="4" Margin="16,4,16,8" Spacing="4">
            <TextBlock
                x:Name="InspectionStatus"
                AutomationProperties.AutomationId="InspectionStatus"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Ctrl+scroll: " /><Run Text="Zoom around the pointer / " />
                <Run FontWeight="SemiBold" Text="Drag: " /><Run Text="Select a specific passage for the spectrum profile and cutoff / " />
                <Run FontWeight="SemiBold" Text="Esc: " /><Run Text="Clear spectrum profile selection" />
            </TextBlock>
        </StackPanel>

        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Done"
            DefaultButton="Close">
            <StackPanel MinWidth="380" Spacing="12">
                <ToggleSwitch x:Name="FullPathToggle" Header="Show the full path above the spectrogram" />
                <ToggleSwitch x:Name="DetailedToggle" Header="Show the FFT size and window function in the description" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox
                        x:Name="UpperBox"
                        Width="176"
                        AutomationProperties.AutomationId="UpperBox"
                        Header="Upper limit (dBFS)"
                        Maximum="0"
                        Minimum="-139"
                        SpinButtonPlacementMode="Inline" />
                    <NumberBox
                        x:Name="LowerBox"
                        Width="176"
                        AutomationProperties.AutomationId="LowerBox"
                        Header="Lower limit (dBFS)"
                        Maximum="-1"
                        Minimum="-140"
                        SpinButtonPlacementMode="Inline" />
                </StackPanel>
                <TextBox
                    x:Name="FfmpegBox"
                    Header="ffmpeg.exe"
                    PlaceholderText="Next to Spek-Z.exe, or on PATH" />
                <TextBlock
                    x:Name="FfmpegStatus"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
