<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Spek.Net</RootNamespace>
    <PackageId>Spek.NET</PackageId>
    <Description>Audio spectrogram analysis for .NET with fast overviews, optional dense FFT analysis, ffmpeg decoding, and Spek's palettes, window functions and rulers.</Description>
    <PackageTags>spek;spectrogram;spectrum;audio;fft;ffmpeg</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spek.Net.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
